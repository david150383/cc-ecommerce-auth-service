# Copy to .env for `npm run dev`. Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0

# Shared local stack (ecommerce-infrastructure: docker compose up -d):
DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5432/auth_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5441/auth_db
# Only for `npm run db:check-drift` (create the database once):
SHADOW_DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5432/auth_shadow
# Integration tests create and drop this database:
TEST_DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5432/auth_test

JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_ACCESS_TTL_SECONDS=900
# <kid>.pem files; a key is generated here on first `npm run dev` (never in production).
JWT_KEYS_DIR=./keys
REFRESH_TOKEN_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Browsers treat http://localhost as secure, so Secure cookies work in local development.
COOKIE_SECURE=true
# COOKIE_DOMAIN=shop.example.com

EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173

# smtp-dev sends straight to Mailpit (http://localhost:8025) until the Notification
# Service exists (Phase 4); then switch to http.
NOTIFICATION_DELIVERY=smtp-dev
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Shop <no-reply@shop.local>"
NOTIFICATION_SERVICE_URL=http://localhost:4006

RATE_LIMIT_ENABLED=true
