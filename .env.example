# Copy to .env for `npm run dev`. All variables are validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# --- Added in Phase 2 ---
# Shared local stack (ecommerce-infrastructure: docker compose up -d):
# DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5432/auth_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://auth_svc:auth_local_pw@localhost:5441/auth_db
# JWT_ISSUER=ecommerce-auth-service
# JWT_AUDIENCE=ecommerce-api
# JWT_ACCESS_TTL_SECONDS=900
# JWT_PRIVATE_KEYS_DIR=./keys          # local only; production keys come from AWS Secrets Manager
# REFRESH_TOKEN_TTL_DAYS=30
# NOTIFICATION_SERVICE_URL=http://localhost:4006
