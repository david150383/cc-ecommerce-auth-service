// Auth Service database (auth_db). Owned exclusively by this service.
// IDs are UUIDv7 generated by the application (time-ordered, index-friendly).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @db.Uuid
  /// Stored lower-cased and trimmed; uniqueness is therefore case-insensitive.
  email           String     @unique @db.VarChar(254)
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(200)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([createdAt])
  @@map("users")
}

/// One login on one device. Refresh tokens rotate inside a session; revoking the
/// session invalidates every refresh token in its family.
model Session {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Absolute lifetime: the session ends here no matter how often it is refreshed.
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason") @db.VarChar(50)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Only the SHA-256 hash of a refresh token is stored. A token with usedAt set has
/// been rotated; presenting it again means it was stolen (reuse detection).
model RefreshToken {
  id        String    @id @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Idle expiry: min(issuedAt + idle lifetime, session.expiresAt).
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Security audit trail. Never contains passwords or tokens.
model AuthAuditLog {
  id            String   @id @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String   @db.VarChar(50)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([userId, occurredAt])
  @@index([action, occurredAt])
  @@map("auth_audit_log")
}

/// Transactional outbox: events are written here in the same transaction as the
/// state change and published to SNS by a relay (Phase 3).
model OutboxMessage {
  id          String    @id @db.Uuid
  messageType String    @map("message_type") @db.VarChar(100)
  /// The complete message envelope, exactly as it will be published.
  envelope    Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
  @@map("outbox")
}
